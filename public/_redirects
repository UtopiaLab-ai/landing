# Estructuras anteriores → estructura nueva. El equivalente en la SPA está en
# LEGACY_REDIRECTS (src/routes.ts), para los hosts que no leen este archivo.

# Servicios → Productos: los "cuatro tramos" eran uno de los cinco listados que
# el catálogo consolidó.
/es/servicios           /es/productos   301
/en/services            /en/products    301
/es/dispositivos        /es/productos   301
/en/devices             /en/products    301

# Sistema y Pensamiento se eliminaron: registro académico y de marca dentro de
# un sitio comercial. El método vive ahora en el catálogo, en lenguaje de
# cliente.
/es/sistema             /es/productos   301
/en/system              /en/products    301
/es/que-es              /es/productos   301
/en/what-it-is          /en/products    301
/es/pensamiento         /es            301
/en/thinking            /en            301

/es/intervenciones      /es/casos       301
/en/interventions       /en/cases       301

# Tablero demo de Atalaya: HTML autónomo, fuera de la SPA.
/atalaya                /atalaya/index.html     200
/atalaya/               /atalaya/index.html     200

# La raíz elige idioma en el servidor: los bots no ejecutan el JS que lo hacía.
/                       /en             302     Language=en
/                       /es             302

# Páginas prerenderizadas. Lo que no está acá responde 404.html con estado 404:
# ya no hay comodín que devuelva 200 para cualquier dirección.
/es                     /es/index.html          200
/es/productos           /es/productos/index.html200
/es/casos               /es/casos/index.html    200
/es/equipo              /es/equipo/index.html   200
/en                     /en/index.html          200
/en/products            /en/products/index.html 200
/en/cases               /en/cases/index.html    200
/en/team                /en/team/index.html     200
