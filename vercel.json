{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/es/servicios", "destination": "/es/productos", "statusCode": 301 },
    { "source": "/en/services", "destination": "/en/products", "statusCode": 301 },
    { "source": "/es/dispositivos", "destination": "/es/productos", "statusCode": 301 },
    { "source": "/en/devices", "destination": "/en/products", "statusCode": 301 },
    { "source": "/es/sistema", "destination": "/es/productos", "statusCode": 301 },
    { "source": "/en/system", "destination": "/en/products", "statusCode": 301 },
    { "source": "/es/que-es", "destination": "/es/productos", "statusCode": 301 },
    { "source": "/en/what-it-is", "destination": "/en/products", "statusCode": 301 },
    { "source": "/es/pensamiento", "destination": "/es", "statusCode": 301 },
    { "source": "/en/thinking", "destination": "/en", "statusCode": 301 },
    { "source": "/es/intervenciones", "destination": "/es/casos", "statusCode": 301 },
    { "source": "/en/interventions", "destination": "/en/cases", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/atalaya", "destination": "/atalaya/index.html" },
    { "source": "/atalaya/", "destination": "/atalaya/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
